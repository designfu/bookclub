.l-current-page
  padding 10px 40px
  max-width 1024px

  .o-json-dump
    padding-top 25px
    margin-top 50px
    border-top 1px solid #000

.c-seasons-page
  &__row
    display flex
    align-items flex-start
    gap 12px

    &--stacked
      flex-direction column
      gap 6px

  &__rank
    width 36px
    min-width 36px
    padding-top 24px
    color #666
    font-weight 600
    font-size 14pt
    line-height 1
    background transparent
    box-shadow none

  &__row--stacked &__rank
    width auto
    min-width 0
    padding-top 0

  &__card
    flex 1 1 auto
    min-width 0
