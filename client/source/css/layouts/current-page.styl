.l-current-page
  padding 10px 20px
  max-width 1024px

  .o-json-dump
    padding-top 25px
    margin-top 50px
    border-top 1px solid #000

.c-current-page__empty-state
  display flex
  flex-direction column
  padding 18px 8px
  color #4a4a4a

  h2
    margin 0 0 6px
    font-weight 500

  p
    margin 0
    color #666

.c-seasons-page
  &__row
    display flex
    gap 12px

    &--stacked
      flex-direction column
      gap 6px

  &__rank
    width 36px
    min-width 36px
    padding-top 24px
    color #666
    font-weight 600
    font-size 14pt
    line-height 1
    background transparent
    box-shadow none

  &__row--stacked &__rank
    width auto
    min-width 0
    padding-top 0

  &__card
    flex 1 1 auto
    min-width 0
