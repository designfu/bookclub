.c-season-info
  padding-top 10px
  margin-top 10px
  max-width 800px

  &__header, &__details, &__admin-info
    padding-left 20px
    padding-right 10px

  &__details
    padding-bottom 20px

  &__date
    label
      font-weight 600
      display inline-block
      margin-right 5px

  .c-vote-card--result
    border-top 1px solid #ccc

  &__rating-description
    font-size 12px

  &__title-row
    display flex
    align-items flex-start
    flex 1 1 auto
    margin-right 10px
    width 100%

  &__title-row--stacked
    flex-direction column
    align-items flex-start

  &__system
    display inline-flex
    align-items center
    align-self flex-start
    justify-content center
    -webkit-user-select none
    user-select none
    font-size 12px
    color #666
    border 1px solid #ddd
    border-radius 10px
    padding 2px 8px
    text-align center

  &__system:not(&__system--stacked)
    margin-left auto

  &__system--stacked
    display block
    margin-bottom 12px
    order 2
    text-align left

  &__voting-results-wrap
    width 100%

  &__voting-results-wrap--scroll
    overflow-x auto
    overflow-y hidden
    -webkit-overflow-scrolling touch

.c-season-info__voting-results-wrap .c-vote-card--result
  min-width 560px
