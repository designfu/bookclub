.c-season-info
  padding-top 10px
  margin-top 10px
  max-width 800px

  &__header, &__details, &__admin-info
    padding-left 20px
    padding-right 10px

  &__details
    padding-bottom 20px

  &__date
    label
      font-weight 600
      display inline-block
      margin-right 5px

  .c-vote-card--result
    border-top 1px solid #ccc

  &__rating-description
    font-size 12px

  &__title-row
    display flex
    align-items center
    gap 10px
    flex 1 1 auto
    margin-right 10px

  &__system
    font-size 12px
    color #666
    border 1px solid #ddd
    border-radius 10px
    padding 2px 8px
    margin-left auto
    text-align right
