.c-book-list
  &__items
    margin 0
    padding 0
    list-style none

  &__placeholder
    display block
    margin 20px
    padding 8px 10px
    border 1px dashed #ddd
    border-radius 4px
    color #666
    font-size 13px

  &__group
    margin-top 14px

    > summary
      cursor pointer
      margin-left 20px
