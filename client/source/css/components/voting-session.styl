.c-voting-session
  margin 10px 0
  max-width 800px
  padding-bottom 130px

  &__notice
    margin 0 0 10px
    padding 10px 12px
    border 1px solid #f0d89a
    border-radius 4px
    background #fff8e1
    color #5f4a00
    font-size 14px

  &__notice-alert
    margin 0

  &__notice-card
    max-width 800px
    margin 0

  &__notice-book-title
    font-style italic !important

  // To put it on top of the tooltips from the user list above it.
  &__actions
    position relative
    z-index 10
