.l-users-page
  padding 8px 16px

.c-users-page-table
  width 100%
  border-collapse collapse
  margin-top 12px
  font-size 13px

  th, td
    border 1px solid #ddd
    padding 8px
    text-align left
    vertical-align top

  th
    background #f5f5f5
    font-weight 600

  tbody tr:nth-child(even)
    background #fafafa

  &__debug
    font-family monospace
    font-size 12px
    color #666

.c-users-transfer-dialog
  &__meta
    display flex
    align-items center
    justify-content space-between
    gap 16px
    margin-bottom 8px

  &__target
    min-width 280px

  &__summary
    margin-bottom 8px
    font-size 13px
    color #555

  &__error
    color #b71c1c
    margin-top 8px

  &__summary-text
    color #1b5e20
    margin-top 8px

.c-users-transfer-table
  width 100%
  border-collapse collapse
  margin-top 8px

  th, td
    border 1px solid #e0e0e0
    padding 6px 8px
    text-align left
    vertical-align top

  th
    background #fafafa

  .is-conflict
    color #b71c1c

  .is-ok
    color #1b5e20
