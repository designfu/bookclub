.c-book-card
  min-width 240px
  max-width 600px
  position relative
  margin 20px 0px
  display block

  &--borderless
    margin 0
    max-width initial
    min-width initial
    box-shadow none

  &--status-break
    margin-top 44px

  &__title
    display block
    font-weight 600

  &__author
    display block
    font-style italic
    font-size 12px

  &__detail
    display block

  &__status
    position absolute
    right 5px
    bottom 5px
    padding 3px 6px
    border-radius 3px
    background #eee
    font-size 12px

  &__metadata
    padding-top: 6px

  &__badges-row
    border-bottom 1px solid rgba(0, 0, 0, .12)
    z-index 2

  &__badges
    display flex
    width 100%

  &__badge
    display inline-flex
    align-items center
    justify-content center
    flex 1 1 0
    min-width 0
    font-size 10px
    line-height 1.5
    text-transform uppercase

    &--suggested
      background #eee
      color #333

    &--reading
      background #1976d2
      color #fff

    &--finished
      background #9e9e9e
      color #fff

    &--your-book
      background #455a64
      color #fff

    &--new
      background #2e7d32
      color #fff

  &__edit-icon
    margin-left auto

  &__image-container
    min-width 136px
    width 136px
    height 136px
    display flex
    box-sizing border-box
    align-items center
    justify-content center

    &--src
      flex-grow 1

    &--no-src

      .c-book-card__image
        width calc(100% - 40px)
        height calc(100% - 40px)

  &__image
    width 100%
    height 100%

  &__image-media
    width 112px
    max-width 112px
    min-width 112px
    flex 0 0 112px
    align-self flex-start
    height 170px

  &__top
    display flex
    flex-direction row
    align-items flex-start
    position relative
    border-bottom 1px solid rgba(0, 0, 0, .12)

  &__details
    .MuiCardHeader-root
      padding 12px 16px 8px

  &__action-delete
    margin-left auto
    color #d32f2f

  &__detail--pitch
    overflow-wrap anywhere
    word-break break-word
