.c-book-card
  min-width 240px
  max-width 600px
  position relative
  margin 20px
  display block

  &--borderless
    margin 0
    max-width initial
    min-width initial
    box-shadow none

  &--status-break
    margin-top 44px

  &__title
    display block
    font-weight 600

  &__author
    display block
    font-style italic
    font-size 12px

  &__detail
    display block
    margin-bottom .5em
    font-size 12px

    &:last-child
      margin-bottom 0

    > label
      font-weight 600
      vertical-align middle

    > span
      vertical-align middle

    &--goodreads
      a
        max-width 130px
        text-overflow ellipsis
        display inline-block
        overflow hidden
        line-height 1
        height 1.1em
        vertical-align top

  &__status
    position absolute
    right 5px
    bottom 5px
    padding 3px 6px
    border-radius 3px
    background #eee
    font-size 12px

  &__badges
    position absolute
    right 8px
    bottom 8px
    z-index 2
    display inline-flex
    flex-wrap wrap
    gap 4px
    justify-content flex-end
    max-width calc(100% - 132px)

  &__badge
    padding 2px 6px
    border-radius 3px
    font-size 11px
    text-transform uppercase

    &--suggested
      background #eee
      color #333

    &--reading
      background #1976d2
      color #fff

    &--finished
      background #9e9e9e
      color #fff

    &--your-book
      background #455a64
      color #fff

    &--new
      background #2e7d32
      color #fff

  &__edit-icon
    margin-left auto

  &__image-container
    min-width 136px
    width 136px
    height 136px
    display flex
    box-sizing border-box
    align-items center
    justify-content center

    &--src
      flex-grow 1

    &--no-src

      .c-book-card__image
        width calc(100% - 40px)
        height calc(100% - 40px)

  &__image
    width 100%
    height 100%

  &__image-media
    background-size cover
    width 112px
    max-width 112px
    min-width 112px
    flex 0 0 112px
    align-self flex-start
    height 170px
    background-position center

    &.no-src
      background-size 90%
      background-position-x 50%

  &__top
    display flex
    flex-direction row
    align-items flex-start
    position relative

  &__details
    flex-grow 1
    margin-left -5px

    .MuiCardHeader-root
      padding 12px 16px 8px

    .MuiCardHeader-action
      margin-top -2px

    .MuiCardHeader-content
      min-width 0

  &__secondary
    border-top 1px solid rgba(0, 0, 0, .12)

  &__detail--pitch
    overflow-wrap anywhere
    word-break break-word

    > label
      display block
      margin-bottom 2px

    > span
      display block
      white-space normal
